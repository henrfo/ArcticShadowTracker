[Unit]
Description=Arctic Shadow Tracker - Maritime Surveillance System
Documentation=https://github.com/henrfo/ArcticShadowTracker
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service
Requires=network.target

[Service]
Type=exec
User=arctic
Group=arctic
WorkingDirectory=/app

# Environment configuration
Environment=PYTHONPATH=/app
Environment=PYTHONUNBUFFERED=1
Environment=LOG_LEVEL=INFO
Environment=DATA_REFRESH_INTERVAL=1800
EnvironmentFile=-/app/config/.env

# Main service command
ExecStart=/usr/bin/python3 -m utils.daily_operations --continuous
ExecReload=/bin/kill -HUP $MAINPID

# Process management
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/app/data /app/logs /app/outputs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryLimit=2G
CPUQuota=150%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arctic-tracker

[Install]
WantedBy=multi-user.target