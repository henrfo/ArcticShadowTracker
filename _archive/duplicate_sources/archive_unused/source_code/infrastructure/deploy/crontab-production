# Arctic Shadow Tracker Production Cron Jobs
# Install with: crontab -u arctic /app/infrastructure/deploy/crontab-production

# Environment variables
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
PYTHONPATH=/app
LOG_DIR=/app/logs
DATA_DIR=/app/data

# Daily surveillance runs
# Run at 06:00, 12:00, 18:00, and 00:00 UTC for comprehensive coverage
0 6 * * * cd /app && python -m utils.daily_operations >> $LOG_DIR/cron_daily_$(date +\%Y\%m\%d).log 2>&1
0 12 * * * cd /app && python -m utils.daily_operations >> $LOG_DIR/cron_daily_$(date +\%Y\%m\%d).log 2>&1
0 18 * * * cd /app && python -m utils.daily_operations >> $LOG_DIR/cron_daily_$(date +\%Y\%m\%d).log 2>&1
0 0 * * * cd /app && python -m utils.daily_operations >> $LOG_DIR/cron_daily_$(date +\%Y\%m\%d).log 2>&1

# Satellite data downloading (every 6 hours, offset by 30 minutes)
30 */6 * * * cd /app && python -m utils.sentinel_downloader >> $LOG_DIR/cron_satellite_$(date +\%Y\%m\%d).log 2>&1

# Weekly comprehensive reports (Sundays at 08:00 UTC)
0 8 * * 0 cd /app && python -c "from utils.daily_operations import DailyOperations; ops = DailyOperations(); print('Weekly report:', ops.generate_weekly_report())" >> $LOG_DIR/cron_weekly_$(date +\%Y\%m\%d).log 2>&1

# System health check (every 15 minutes)
*/15 * * * * cd /app && python -c "from infrastructure.deploy.health_monitor import check_system_health; check_system_health()" >> $LOG_DIR/cron_health_$(date +\%Y\%m\%d).log 2>&1

# Data cleanup - remove logs older than 30 days (daily at 02:00)
0 2 * * * find $LOG_DIR -name "*.log" -mtime +30 -delete

# Data cleanup - remove old daily operational data older than 90 days (weekly on Saturday at 03:00)
0 3 * * 6 find $DATA_DIR/operational/daily -type d -mtime +90 -exec rm -rf {} + 2>/dev/null || true

# Backup critical data (daily at 04:00)
0 4 * * * cd /app && python -c "from infrastructure.deploy.backup_manager import perform_daily_backup; perform_daily_backup()" >> $LOG_DIR/cron_backup_$(date +\%Y\%m\%d).log 2>&1

# Alert system test (daily at 07:30 to ensure notifications work)
30 7 * * * cd /app && python -c "from infrastructure.deploy.alert_system import test_alert_system; test_alert_system()" >> $LOG_DIR/cron_alert_test_$(date +\%Y\%m\%d).log 2>&1

# Performance monitoring - log system metrics (every 5 minutes)
*/5 * * * * cd /app && python -c "from infrastructure.deploy.metrics_collector import collect_system_metrics; collect_system_metrics()" >> $LOG_DIR/metrics_$(date +\%Y\%m\%d).log 2>&1