# Arctic Shadow Tracker - Production Environment Configuration
# Copy this file to .env and configure your specific settings

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Core application settings
PYTHONPATH=/app
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
DATA_PERSISTENCE_ENABLED=1
VISUALIZATION_ENABLED=1
METRICS_ENABLED=1
HEALTH_CHECK_ENABLED=1

# Data pipeline settings
DATA_REFRESH_INTERVAL=1800  # 30 minutes
SURVEILLANCE_UPDATE_INTERVAL=21600  # 6 hours (for SAR data)

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL settings (if using external database)
# DATABASE_URL=postgresql://arctic_user:your_password@localhost:5432/arctic_surveillance
POSTGRES_PASSWORD=your_secure_postgres_password

# Redis settings (cache and task queues)
REDIS_URL=redis://redis:6379/0

# =============================================================================
# EXTERNAL API CONFIGURATION
# =============================================================================

# Copernicus/Sentinel Hub API credentials
# Sign up at: https://scihub.copernicus.eu/dhus/#/self-registration
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password

# AIS data API key (optional - system works with demo data)
# AIS_API_KEY=your_ais_api_key

# =============================================================================
# ALERT AND NOTIFICATION CONFIGURATION
# =============================================================================

# Email alerts configuration
EMAIL_ALERTS_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_or_token
EMAIL_FROM=arctic-tracker@your-domain.com
EMAIL_TO=admin@your-domain.com,ops@your-domain.com

# Webhook alerts configuration
WEBHOOK_ALERTS_ENABLED=false
WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
WEBHOOK_TOKEN=your_webhook_authentication_token

# Slack alerts configuration
SLACK_ALERTS_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#arctic-surveillance

# Daily summary notifications
DAILY_SUMMARY_ENABLED=true

# =============================================================================
# MONITORING AND METRICS
# =============================================================================

# Prometheus settings
PROMETHEUS_PORT=9090

# Grafana settings
GRAFANA_PASSWORD=your_secure_grafana_password

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Application security
SECRET_KEY=your_very_secure_secret_key_here_use_at_least_32_characters
JWT_SECRET=your_jwt_secret_key_for_api_authentication

# API rate limiting and security
API_RATE_LIMIT=1000  # requests per hour
ENABLE_API_AUTH=false  # Set to true in production

# =============================================================================
# GEOGRAPHIC AND OPERATIONAL SETTINGS
# =============================================================================

# Arctic surveillance area bounds (default covers Svalbard/Barents Sea)
SURVEILLANCE_AREA_NORTH=82.0
SURVEILLANCE_AREA_SOUTH=69.0
SURVEILLANCE_AREA_WEST=5.0
SURVEILLANCE_AREA_EAST=35.0

# Threat detection thresholds
CRITICAL_THREAT_DISTANCE_KM=1.0
HIGH_THREAT_DISTANCE_KM=2.0
CABLE_PROXIMITY_THRESHOLD_KM=5.0

# Vessel tracking parameters
AIS_MATCHING_THRESHOLD_METERS=1000
SAR_CONFIDENCE_THRESHOLD=0.6
DARK_VESSEL_TIME_TOLERANCE_MINUTES=30

# =============================================================================
# DEPLOYMENT SPECIFIC SETTINGS
# =============================================================================

# Environment identifier
ENVIRONMENT=production
DEPLOYMENT_VERSION=1.0.0

# Backup configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# Performance tuning
MAX_WORKER_PROCESSES=4
WORKER_MEMORY_LIMIT=2G
PROCESSING_BATCH_SIZE=100

# =============================================================================
# DEVELOPMENT AND TESTING OVERRIDES
# =============================================================================
# Uncomment these for development/testing environments

# LOG_LEVEL=DEBUG
# EMAIL_ALERTS_ENABLED=false
# WEBHOOK_ALERTS_ENABLED=false
# DAILY_SUMMARY_ENABLED=false
# ENVIRONMENT=development